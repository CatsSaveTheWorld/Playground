IOTCORE_MQTT_HOST=192.168.0.8
IOTCORE_MQTT_PORT=1884
IOTCORE_MQTT_USERNAME=iotcore-ai-pc
IOTCORE_MQTT_PASSWORD_FILE=C:\IoTCore\node-telemetry\mqtt-password
IOTCORE_NODE_UID=home-ai-main
IOTCORE_TELEMETRY_INTERVAL=1
# Example: C:\ or D:\AI
IOTCORE_STORAGE_PATH=C:\
# Example Windows adapter name from psutil.net_io_counters(pernic=True)
IOTCORE_NETWORK_INTERFACE=
IOTCORE_ASR_HEALTH_URL=http://127.0.0.1:6101/health
IOTCORE_NLP_HEALTH_URL=http://127.0.0.1:6201/health
IOTCORE_HEALTH_INTERVAL=5
IOTCORE_GPU_MONITOR=1
