[Unit]
Description=IoTCore node telemetry agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leedowon
Group=leedowon
EnvironmentFile=/home/leedowon/.config/iotcore-node-telemetry/agent.env
ExecStart=/home/leedowon/.local/share/iotcore-node-telemetry/venv/bin/python /home/leedowon/.local/share/iotcore-node-telemetry/node_telemetry_agent.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
