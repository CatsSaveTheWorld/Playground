[Unit]
Description=IoTCore YouTube Music cookie agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leedowon
Group=leedowon
EnvironmentFile=/home/leedowon/.config/ytmusic-cookie-agent/agent.env
ExecStart=/home/leedowon/ytmusic-cookie-collector/.agent-venv/bin/python /home/leedowon/ytmusic-cookie-collector/agent.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
